#!/bin/bash

set -e

# OmiSu ships no default agent, so invite once rather than picking one. An
# agent already chosen means the invitation has nothing to offer.
if [[ -z $(omisu-default-agent) ]] && omisu-done ensure agent-setup-invitation; then
  omisu-notification-send -u critical -g 󰚩 "Set your default agent" \
    "Let your favorite agent help with OmiSu." \
    --exec omisu menu summon setup.default.agent
fi
