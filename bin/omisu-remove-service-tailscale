#!/bin/bash

# omisu:summary=Remove Tailscale and its bar plugin.
# omisu:requires-sudo=true

tailscale down 2>/dev/null || true
systemctl --user disable --now omisu-tailscale-receive.service 2>/dev/null || true
sudo systemctl disable --now tailscaled.service 2>/dev/null || true
omisu-plugin-disable omisu.tailscale
omisu-webapp-remove "Tailscale" 2>/dev/null || true
omisu-pkg-drop tailscale

echo ""
echo "Tailscale has been removed."
