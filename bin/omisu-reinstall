#!/bin/bash

# omisu:summary=Reinstall OmiSu packages and reset default configs
# omisu:requires-sudo=true

set -e

echo -e "This will reinstall all default OmiSu packages and reset default configs.\nWarning: user config changes will be overwritten.\n"

if gum confirm "Are you sure you want to reinstall and lose config changes?"; then
  omisu-reinstall-pkgs
  omisu-reinstall-configs

  gum confirm "System has been reinstalled. Reboot?" && omisu-system-reboot
fi
