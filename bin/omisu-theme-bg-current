#!/bin/bash

# omisu:summary=Show current background
# omisu:examples=omisu theme bg current

BACKGROUND_PATH=$(readlink -f "$HOME/.local/state/omisu/current/background" 2>/dev/null)

if [[ -n $BACKGROUND_PATH ]]; then
  basename -- "$BACKGROUND_PATH" | perl -pe 's/\.[^.]+$//; s/^\d+-//; s/-/ /g; s/\b(\w)/\U$1/g'
else
  echo "Unknown"
fi
