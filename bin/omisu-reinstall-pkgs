#!/bin/bash

# omisu:summary=Reinstall all default OmiSu packages from the stable channel
# omisu:requires-sudo=true

set -e

# Reinstall all default OmiSu packages from the stable channel and downgrade any packages that are too new.

# Set the package repository to the stable mirrors
omisu-refresh-pacman

# Downgrade any packages to the stable setup
sudo env OMISU_UPDATE_PACMAN=1 pacman -Suu --noconfirm

# Ensure all packages are installed
mapfile -t packages < <(grep -v '^#' "$OMISU_PATH/install/omisu-base.packages" | grep -v '^$')
sudo env OMISU_UPDATE_PACMAN=1 pacman -Syu --noconfirm --needed "${packages[@]}"
