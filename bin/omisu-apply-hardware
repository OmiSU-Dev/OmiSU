#!/bin/bash

# omisu:summary=Apply OmiSu hardware-specific packages and system configuration
# omisu:group=apply
# omisu:requires-sudo=true
# omisu:examples=omisu apply hardware --install-user dhh
# omisu:hidden=true

set -euo pipefail

usage() {
  cat <<USAGE
Usage: omisu apply hardware --install-user USER
       omisu apply hardware --defer-provisioning

Runs idempotent hardware detection/setup for the installed machine. This is
called by omisu-apply-system during ISO finalization and can be rerun later
for diagnostics or after hardware/package updates.

--defer-provisioning runs without an install user (deferred-provisioning installs create the user at
first boot); group grants are recorded in /var/lib/omisu/provisioning/groups.
USAGE
}

install_user="${OMISU_INSTALL_USER:-}"
defer_provisioning=0
while (($#)); do
  case "$1" in
    --install-user)
      install_user="${2:-}"
      shift 2
      ;;
    --defer-provisioning)
      defer_provisioning=1
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      echo "Unknown option: $1" >&2
      usage >&2
      exit 1
      ;;
  esac
done

if (( EUID != 0 )); then
  echo "Error: omisu-apply-hardware must run as root" >&2
  exit 1
fi

if (( defer_provisioning )); then
  install_user=""
else
  if [[ -z $install_user || $install_user == "root" ]]; then
    echo "Error: --install-user must name the target non-root user" >&2
    exit 1
  fi

  if ! getent passwd "$install_user" >/dev/null; then
    echo "Error: user '$install_user' does not exist" >&2
    exit 1
  fi
fi

export OMISU_INSTALL_USER="$install_user"
export OMISU_PATH="${OMISU_PATH:-/usr/share/omisu}"
export OMISU_INSTALL="${OMISU_INSTALL:-$OMISU_PATH/install}"
export OMISU_INSTALL_LOG_FILE="${OMISU_INSTALL_LOG_FILE:-/var/log/omisu-install.log}"
export PATH="$OMISU_PATH/bin:$PATH"

source "$OMISU_INSTALL/helpers/logging.sh"
source "$OMISU_INSTALL/hardware/all.sh"
