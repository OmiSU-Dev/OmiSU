#!/bin/bash

# omisu:summary=Select and set the system timezone
# omisu:group=menu
# omisu:name=timezone

set -e

timezone=$(timedatectl list-timezones | omisu-menu-select "Set timezone" -- --width 520 --maxheight 520) || exit 1
sudo timedatectl set-timezone "$timezone"
omisu-shell -q omisu.clock refresh
omisu-notification-send "Timezone is now set to $timezone"
