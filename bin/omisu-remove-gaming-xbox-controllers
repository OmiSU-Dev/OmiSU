#!/bin/bash

# omisu:summary=Remove the xpadneo Xbox controller driver and undo its module/blacklist config.
# omisu:group=remove
# omisu:name=gaming xbox-controllers
# omisu:requires-sudo=true

set -e

omisu-pkg-drop xpadneo-dkms

sudo rm -f /etc/modprobe.d/blacklist-xpad.conf /etc/modules-load.d/xpadneo.conf

echo ""
echo "Xbox controller support removed. Reboot to fully unload xpadneo and restore xpad."
