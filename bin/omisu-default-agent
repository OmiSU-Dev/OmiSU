#!/usr/bin/env bash
# omisu:summary=Set or report the default AI coding agent.
#
# omisu-default-agent — set or report the default AI coding agent.
#
#   omisu-default-agent              print the current default agent
#   omisu-default-agent <name>       set the default agent (claude|codex|opencode|gemini|ollama|...)
#   omisu-default-agent --pick       interactive picker (whiptail)
#   omisu-default-agent --install    install the CLI for the chosen agent if missing
#
# Unlike OmiSu (which uses `mise`), OmiSu expects the agent CLI to be
# installed on the system (or installable via the distro / npm / pip). This
# script only records the choice in agent.conf and verifies the binary exists.
#
set -euo pipefail

CONFIG_DIR="$HOME/.config/omisu"
AGENT_CONF="$CONFIG_DIR/agent.conf"
SHARE="/usr/share/omisu"

AGENTS=("claude" "codex" "opencode" "gemini" "ollama" "herder" "copilot" "grok" "crush")
NAMES=(["claude"]="Claude Code" ["codex"]="Codex" ["opencode"]="OpenCode"
       ["gemini"]="Gemini CLI" ["ollama"]="Ollama" ["herder"]="Herder"
       ["copilot"]="GitHub Copilot" ["grok"]="Grok" ["crush"]="Crush")

PICK=0
INSTALL=0
for a in "$@"; do
  case "$a" in
    --pick|-p) PICK=1 ;;
    --install|-i) INSTALL=1 ;;
    -*) echo "Unknown flag: $a" >&2; exit 1 ;;
    *) AGENT_ARG="$a" ;;
  esac
done

mkdir -p "$CONFIG_DIR"

set_agent() {
  local agent="$1"
  # Ensure OMISU_AGENT line exists/updated in agent.conf.
  if [ -f "$AGENT_CONF" ]; then
    if grep -q '^OMISU_AGENT=' "$AGENT_CONF"; then
      sed -i "s/^OMISU_AGENT=.*/OMISU_AGENT=\"$agent\"/" "$AGENT_CONF"
    else
      printf '\nOMISU_AGENT="%s"\n' "$agent" >> "$AGENT_CONF"
    fi
  else
    printf 'OMISU_AGENT="%s"\n' "$agent" > "$AGENT_CONF"
  fi
  echo "OmiSu: default agent set to $agent"
}

known() {
  local a name
  for a in "${AGENTS[@]}"; do
    [ "$a" = "$1" ] && return 0
  done
  return 1
}

if [ "$PICK" -eq 1 ]; then
  if ! command -v whiptail >/dev/null 2>&1; then
    echo "whiptail not found. Set directly: omisu-default-agent <name>" >&2
    exit 1
  fi
  local i=0 opts=()
  for a in "${AGENTS[@]}"; do
    opts+=("$a" "${NAMES[$a]:-$a}")
  done
  choice=$(whiptail --title "OmiSu — Default Agent" --menu "Choose an AI agent:" 20 50 10 "${opts[@]}" 3>&1 1>&2 2>&3) || exit 1
  set_agent "$choice"
  exit 0
fi

if [ -z "${AGENT_ARG:-}" ]; then
  # Report current.
  [ -f "$AGENT_CONF" ] && . "$AGENT_CONF"
  echo "${OMISU_AGENT:-}"
  exit 0
fi

if ! known "$AGENT_ARG"; then
  echo "Unknown agent '$AGENT_ARG'. Known: ${AGENTS[*]}" >&2
  exit 1
fi

if [ "$INSTALL" -eq 1 ] && ! command -v "$AGENT_ARG" >/dev/null 2>&1; then
  echo "OmiSu: '$AGENT_ARG' not found on PATH. Install it via your package manager," >&2
  echo "then run: omisu-default-agent $AGENT_ARG" >&2
  exit 1
fi

set_agent "$AGENT_ARG"
