#!/bin/bash

# omisu:summary=Toggle microphone mute. Drives the hardware mic-mute LED on laptops that expose one.

wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle >/dev/null

if wpctl get-volume @DEFAULT_AUDIO_SOURCE@ | grep -q MUTED; then
  omisu-brightness-keyboard-mute on
  omisu-osd -i microphone-muted -m "Microphone muted"
else
  omisu-brightness-keyboard-mute off
  omisu-osd -i microphone -m "Microphone on"
fi
