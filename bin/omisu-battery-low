#!/bin/bash

# omisu:summary=Send the low battery warning notification and run battery-low hooks.
# omisu:args=<percentage>
# omisu:hidden=true

set -euo pipefail

if (($# != 1)); then
  echo "Usage: omisu-battery-low <percentage>" >&2
  exit 1
fi

level=$1

omisu-notification-send -g 󱐋 -u critical "Time to recharge!" "Battery is down to ${level}%" -i battery-caution -t 30000
omisu-hook battery-low "$level"
