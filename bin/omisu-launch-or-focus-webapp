#!/bin/bash

# omisu:summary=Launch or focus on a given web app identified by the window-pattern.
# omisu:args=<window-pattern> <url-and-flags...>

if (($# == 0)); then
  echo "Usage: omisu-launch-or-focus-webapp [window-pattern] [url-and-flags...]"
  exit 1
fi

WINDOW_PATTERN="$1"
shift
LAUNCH_COMMAND="omisu-launch-webapp $@"

exec omisu-launch-or-focus "$WINDOW_PATTERN" "$LAUNCH_COMMAND"
