#!/bin/bash

# omisu:summary=Install and start the Dropbox service. Must then be authenticated via the web.

echo "Installing all dependencies..."
omisu-pkg-add dropbox dropbox-cli libappindicator-gtk3 python-gpgme nautilus-dropbox

echo "Adding Dropbox to the bar..."
omisu-plugin-enable omisu.dropbox

echo "Starting Dropbox..."
uwsm-app -- dropbox-cli start &>/dev/null &
echo "See Dropbox icon behind  hover tray in top right and right-click for setup."
