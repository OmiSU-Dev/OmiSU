#!/bin/bash

# omisu:summary=Print the active OmiSu package channel

set -euo pipefail

# Dev is a linked source checkout: OMISU_PATH points somewhere other than
# the package-backed install at /usr/share/omisu. This takes precedence over
# the package channels, since the checkout overrides whatever is installed.
if [[ $OMISU_PATH != "/usr/share/omisu" ]]; then
  echo dev
  exit 0
fi

# omisu-dev / omisu-settings-dev are only shipped from the edge package
# repo, so their presence alone means edge. omisu / omisu-settings come
# from either the stable or rc mirror, distinguished by omisu-version-channel
# (which reports the mirror as its first token).
if pacman -Q omisu-dev omisu-settings-dev >/dev/null 2>&1; then
  echo edge
elif pacman -Q omisu omisu-settings >/dev/null 2>&1; then
  channel=$(omisu-version-channel 2>/dev/null | awk '{ print $1 }')
  case "$channel" in
    stable) echo stable ;;
    rc) echo rc ;;
    *) echo unknown ;;
  esac
else
  echo unknown
fi
