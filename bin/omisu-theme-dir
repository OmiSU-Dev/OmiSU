#!/bin/bash

# omisu:summary=Print the directory holding a theme, preferring a user-installed copy
# omisu:args=<theme-name>
# omisu:examples=omisu theme dir tokyo-night

theme="${1:-}"

if [[ -z $theme ]]; then
  echo "Usage: omisu-theme-dir <theme-name>" >&2
  exit 1
fi

if [[ -d $HOME/.config/omisu/themes/$theme ]]; then
  echo "$HOME/.config/omisu/themes/$theme"
else
  echo "$OMISU_PATH/themes/$theme"
fi
