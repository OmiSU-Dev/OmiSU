#!/bin/bash

# omisu:summary=Update the active OmiSu dev checkout

set -euo pipefail

[[ $OMISU_PATH != "/usr/share/omisu" ]] || exit 0

if ! git -C "$OMISU_PATH" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
  echo "Error: OMISU_PATH is not a git checkout: $OMISU_PATH" >&2
  exit 1
fi

upstream=$(git -C "$OMISU_PATH" rev-parse --abbrev-ref --symbolic-full-name '@{upstream}' 2>/dev/null || true)
if [[ -z $upstream ]]; then
  echo -e "\e[33m\nSkip OmiSu dev checkout update (current branch has no upstream)\e[0m"
  exit 0
fi

echo -e "\e[32m\nUpdate OmiSu dev checkout\e[0m"
git -C "$OMISU_PATH" pull --ff-only
