#!/bin/bash

# omisu:summary=Launch a TUI or focus an existing terminal window for it
# omisu:args=[--app-id=<app-id>] <command> [args...]

if [[ ${1:-} == --app-id=* ]]; then
  APP_ID="${1#--app-id=}"
else
  APP_ID="org.omisu.$(basename "$1")"
fi

LAUNCH_COMMAND="omisu-launch-tui $@"

exec omisu-launch-or-focus "$APP_ID" "$LAUNCH_COMMAND"
