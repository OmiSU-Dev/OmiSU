{
  "version": 1,
  "idle": {
    "screensaver": 150,
    "lock": 300
  },
  "bar": {
    "position": "top",
    "transparent": false,
    "centerAnchor": "omisu.clock",
    "layout": {
      "left": [
        {
          "id": "omisu.menu"
        },
        {
          "id": "omisu.workspaces"
        }
      ],
      "center": [
        {
          "id": "omisu.indicators"
        },
        {
          "id": "omisu.clock",
          "format": "dddd HH:mm",
          "formatAlt": "d MMMM 'W'ww yyyy",
          "verticalFormat": "HH\n\u2014\nmm"
        },
        {
          "id": "omisu.keyboard-layout"
        },
        {
          "id": "omisu.weather"
        },
        {
          "id": "omisu.system-update"
        }
      ],
      "right": [
        {
          "id": "omisu.tray"
        },
        {
          "id": "omisu.agents"
        },
        {
          "id": "omisu.bluetooth"
        },
        {
          "id": "omisu.network"
        },
        {
          "id": "omisu.audio"
        },
        {
          "id": "omisu.monitor"
        },
        {
          "id": "omisu.power"
        }
      ]
    }
  },
  "plugins": []
}
