# Single source of truth for OMISU_PATH + PATH adjustments. Sourced by:
#   /etc/profile.d/omisu.sh                 (system login shells)
#   /etc/skel/.bashrc                         (interactive shells)
#   /usr/share/uwsm/env.d/10-omisu          (Hyprland session via uwsm)
#   /usr/share/omisu/default/bash/envs      (bash rc chain; SSH/non-login)

# /etc/omisu.conf is written by omisu-dev-link and reset by
# omisu-dev-unlink. When absent, force the packaged default instead of
# preserving a stale inherited value.
if [ -f /etc/omisu.conf ]; then
  . /etc/omisu.conf
  : "${OMISU_PATH:=/usr/share/omisu}"
else
  OMISU_PATH=/usr/share/omisu
fi
export OMISU_PATH

# Only prepend in dev-link mode. On a production install, the binaries are
# already on PATH as /usr/bin/omisu-* via the omisu package — prepending
# /usr/share/omisu/bin would just be noise.
if [ "$OMISU_PATH" != /usr/share/omisu ]; then
  case ":$PATH:" in
    *":${OMISU_PATH%/}/bin:"*) ;;
    *) PATH="${OMISU_PATH%/}/bin${PATH:+:$PATH}" ;;
  esac
fi

# User-level tool paths, appended so system binaries keep precedence. This is
# what lets login shells (ssh, bash -lc) and the uwsm session find mise-managed
# tools without an interactive rc. Keep these directories in sync with the PAM
# PATH line from install/config/ssh-command-path.sh, which covers SSH commands
# that run no shell setup at all.
case ":$PATH:" in
  *":$HOME/.local/share/mise/shims:"*) ;;
  *) PATH="${PATH:+$PATH:}$HOME/.local/share/mise/shims" ;;
esac
case ":$PATH:" in
  *":$HOME/.local/bin:"*) ;;
  *) PATH="${PATH:+$PATH:}$HOME/.local/bin" ;;
esac
export PATH
